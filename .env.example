GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Legacy/local Drive OAuth. The historical pair below remains Primary's route for
# backwards compatibility. A second Secondary pair is optional; configure both Secondary
# values together to enable two-user Drive routing.
DRIVE_AUTH_MODE=local
DRIVE_OAUTH_CLIENT_FILE=credentials.json
DRIVE_OAUTH_TOKEN_FILE=token.json
DRIVE_INPUT_FOLDER_ID=your_primary_input_folder_id
DRIVE_OUTPUT_FOLDER_ID=your_primary_output_folder_id
DRIVE_SECONDARY_INPUT_FOLDER_ID=
DRIVE_SECONDARY_OUTPUT_FOLDER_ID=

# Cloud Run example (enable instead of the local settings above):
# DRIVE_AUTH_MODE=authorized_user_json
# DRIVE_OAUTH_TOKEN_JSON is injected from Secret Manager in Cloud Run.
# DRIVE_INPUT_FOLDER_ID and DRIVE_OUTPUT_FOLDER_ID continue to identify Primary.
# DRIVE_SECONDARY_INPUT_FOLDER_ID / DRIVE_SECONDARY_OUTPUT_FOLDER_ID enable Secondary.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_MAX_DOWNLOAD_BYTES=20971520

POLL_INTERVAL_SECONDS=60
# Use RUN_MODE=once for a scheduled one-task Cloud Run Job invocation.
RUN_MODE=continuous
CHUNK_SLEEP_SECONDS=3
LOCAL_STATE_FILE=processed_files.json
TRANSCRIPT_CACHE_DIR=transcript_cache
TEMP_DIR=tmp
OUTPUT_DIR=output

# Safe local state default. Cloud configuration is documented separately.
STATE_BACKEND=local

MAX_FILE_RETRIES=5
MAX_NETWORK_FILE_RETRIES=0
FILE_RETRY_BASE_SECONDS=300
FILE_RETRY_MAX_SECONDS=3600
NETWORK_FILE_RETRY_BASE_SECONDS=30
NETWORK_FILE_RETRY_MAX_SECONDS=300

# Optional. When omitted, the bot discovers Segoe UI (Windows) or DejaVu/Liberation Sans (Linux).
# PDF_FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# PDF_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
